# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://finshield:localdev123@localhost:5432/finshield

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=local-dev-secret-change-in-prod
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Azure Event Hub ───────────────────────────────────────────────────────────
# Leave empty in local dev — streaming will use stub mode
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_NAMESPACE=
EVENT_HUB_TRANSACTIONS_NAME=transactions
EVENT_HUB_ALERTS_NAME=alerts
EVENT_HUB_CONSUMER_GROUP=fraud-processor

# ── Azure Storage ─────────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=

# ── ML ────────────────────────────────────────────────────────────────────────
ML_MODEL_PATH=app/ml/models
ML_FRAUD_MODEL_VERSION=latest

# ── Email (MailHog in dev) ────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=DEBUG
DEBUG=true
